# ==========================================================================
# Mallorn contrastive pretraining config
# Usage:
#   python3 -m romae_mallorn env_pretrain_contrastive --env_file example_run.env
#
# All keys are prefixed mallorn_ (env_prefix in MallornConfigContrastiveEnv).
# Not running on the Vega cluster -> mallorn_vega left False (default),
# so num_dataset_workers is NOT overridden via sched_getaffinity; set it
# explicitly below instead if you want more than the library default.
# ==========================================================================

# --- Run identity ---
mallorn_model_name=/scratch/gcontard/ELASTICC2/mallorn_like/verytiny_supcon_Npos100_run1

# --- Data source: pool-based resampling ---
# Leave train_parquet / test_parquet UNSET when using train_pool_parquet;
# the pipeline resamples train/val from the pool each run and saves the
# exact IDs used to <model_name>_<run_id>_indices.json (+ logged to W&B).

mallorn_train_pool_parquet=/scratch/gcontard/ELASTICC2/mallorn_like/pool_5000TDE_100000neg_20000unsup_seed42.parq
mallorn_id_column=ObjectId

# How many of each class to draw from the pool this run
mallorn_n_positive=100
mallorn_n_negative=2000
mallorn_n_unsup=3000

# Fraction of each drawn class held out for validation (fixed for this run,
# reloadable later via filter_pool_by_record for the 2nd-stage classifier)

mallorn_val_fraction=0.2

# Leave unset to draw+log a fresh random seed each run (recommended for a
# sweep over multiple realizations at the same N_positive). Set explicitly
# to reproduce/reuse one specific split.
# mallorn_resample_seed=

mallorn_resample_with_replacement=False

# --- Model ---
mallorn_model_size=tinyer-midshallow_6
# mallorn_decoder_size=          # unset -> defaults to encoder d_model
MALLORN_PROJECTION_DIM=32
MALLORN_CLS_CONTRASTIVE_DIM=32


# --- Pretraining schedule ---
mallorn_pretrain_epochs=40

mallorn_pretrain_batch_size=64

mallorn_pretrain_eval_every=100
mallorn_pretrain_save_every=200
mallorn_pretrain_mask_ratio=0.5
mallorn_pretrain_grad_clip=1.0
mallorn_max_checkpoints=50

# --- Contrastive head ---
mallorn_temperature=0.15
mallorn_projection_head=False
mallorn_class_contrast_weight=1.0
mallorn_aug_contrast_weight=0.0
mallorn_recon_weight=1.0
mallorn_n_views=2
mallorn_mask_ratio_contrastive=0.5
mallorn_decode=True
mallorn_unsup_in_denominator=False

# --- Guaranteed-quota batch sampler ---
# K_positive + K_negative + K_unlabeled must equal pretrain_batch_size.
# K_negative is derived automatically (batch_size - K_positive - K_unlabeled)
# if left unset, so it's commented out here.
mallorn_K_positive_batch=5
# mallorn_K_negative_batch=
mallorn_K_unlabeled_batch=10

# Fix this across your whole N_positive sweep (compute once off the run
# with the LARGEST N_positive) so every run gets an equal optimizer-step
# budget. Leaving it unset derives it locally per-run, which is fine for
# a single one-off run but NOT fine for a sweep you want compute-matched.
mallorn_n_batches_per_epoch=60

# --- Observation dropout (train-time augmentation) ---
mallorn_obs_dropout_end_trim=0.05
mallorn_obs_dropout_edge_erosion=0.04
mallorn_gap_threshold_factor=20.0
mallorn_random_dropout_ratio=0.04

# --- Misc ---
mallorn_gaussian_noise=False
mallorn_vega=False
mallorn_project_name=contrastive_
mallorn_entity_name=contardog-university-of-nova-gorica